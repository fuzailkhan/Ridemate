{
  "expo": {
    "name": "RideMate",
    "slug": "ridemate",
    "version": "0.1.0",
    "scheme": "ridemate",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0B0D10"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ridemate.app"
    },
    "android": {
      "package": "com.ridemate.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10"
      }
    },
    "web": {
  "bundler": "metro",
  "output": "single",
  "favicon": "./assets/favicon.png"
},
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
