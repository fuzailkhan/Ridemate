# Firebase client configuration (not secret — safe to expose in a mobile bundle,
# but keep out of version control by convention). Copy this file to .env and
# fill in real values from the Firebase Console: Project settings > General >
# Your apps > Web app > SDK setup and configuration > Config.
#
# Expo automatically inlines any EXPO_PUBLIC_ prefixed variable into the
# client bundle at build time — this is the standard Expo-compatible way to
# supply client config, no extra package required.

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBQQoCPBbjNmLXvzF7ZfLuN1tdlB8gdRlo
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=ridemate-4781b.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ridemate-4781b
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=ridemate-4781b.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=753469043253
EXPO_PUBLIC_FIREBASE_APP_ID=1:753469043253:web:c3a96cda6b632b5550377c
